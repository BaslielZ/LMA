<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LifeManagementApp.ViewModels"
             x:Class="LifeManagementApp.Views.NotePage"
             Title="Note"
             x:DataType="viewModels:NoteDetailViewModel">

    <VerticalStackLayout Spacing="10" Margin="5">
        <Entry Text="{Binding Note.Title}" Placeholder="Enter title" />

        <Editor x:Name="TextEditor"
                Placeholder="Enter your note"
                Text="{Binding Note.Text}"
                HeightRequest="150" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
            <Button Text="Save"
                    Command="{Binding SaveCommand}" />

            <Button Grid.Column="1"
                    Text="Delete"
                    Command="{Binding DeleteCommand}" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>
